<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Banking Demo</title>
    <style>
        :root { font-family: system-ui, sans-serif; color: #142331; background: #f2f5f8; }
        body { margin: 0; }
        header { background: #102e45; color: white; padding: 1rem max(1rem, calc((100vw - 880px)/2)); display: flex; justify-content: space-between; align-items: center; }
        header a { color: white; text-decoration: none; font-weight: 700; }
        main { max-width: 880px; margin: 2rem auto; padding: 0 1rem; }
        .card { background: white; padding: 1.5rem; margin: 1rem 0; border-radius: .7rem; box-shadow: 0 2px 12px #102e4514; }
        label { display: block; margin: 1rem 0 .35rem; font-weight: 600; }
        input, select { box-sizing: border-box; width: 100%; max-width: 440px; padding: .65rem; border: 1px solid #9aa9b5; border-radius: .3rem; font: inherit; }
        button { margin-top: 1rem; padding: .7rem 1rem; border: 0; border-radius: .3rem; background: #075e79; color: white; font: inherit; cursor: pointer; }
        a { color: #075e79; }
        .error, .validation-summary-errors, .field-validation-error { color: #a32222; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: .7rem; text-align: left; border-bottom: 1px solid #dce3e8; }
        .scroll { overflow-x: auto; }
        .note { color: #536674; }
    </style>
</head>
<body>
<header><a href="/web">Banking Demo</a><span>Learning prototype</span></header>
<main>@RenderBody()</main>
</body>
</html>
